DATABASE_URL="file:./dev.db"
AUTH_SECRET="troque-por-uma-chave-longa-e-aleatoria"
# true somente quando o site for HTTPS
COOKIE_SECURE="false"
# Endereço público do app, sem barra no final. O Google exige um nome
# (https://cantina.exemplo.ifsc.edu.br). http://localhost:3000 vale para teste.
# Endereço IP, como http://172.16.110.6, o Google não aceita.
APP_URL="http://localhost:3000"
# Credenciais OAuth (tipo Web) do Google Cloud. Tela de consentimento: Interna.
# URI de redirecionamento: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Envio da senha temporária (esqueci a senha)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cantina IFSC <cantina@ifsc.edu.br>"
# true se a porta for 465
SMTP_SECURE="false"
